<resources>
    <!-- Store-facing display name (D-decision §0). Package id stays com.understory.antivirus. -->
    <string name="app_name">Understory APK Check</string>

    <!-- Positioning (§0) -->
    <string name="av_positioning">Works alongside Google Play Protect. Play Protect checks apps against Google\'s cloud at install time; APK Check inspects sideloaded APKs and what your installed apps can do — offline, on your device, showing its work.</string>

    <!-- Home "what this catches" (§1.6) — reflects exactly the shipped mechanisms. -->
    <string name="av_home_catches">What this catches: a signed offline deny-list (Lucky-Patcher-family and known repackager signing certs; import more via a signed file), permission-shape heuristics, hidden-from-launcher detection, and abuser enumeration for accessibility / device-admin / notification-listener — including which are enabled right now. What it doesn\'t: novel zero-days or running-process behavior. Treat findings as advisory, not verdicts.</string>

    <!-- Home actions -->
    <string name="av_scan_apk">Scan an APK file</string>
    <string name="av_audit_installed">Audit installed apps</string>
    <string name="av_diagnostics">Diagnostics</string>
    <string name="av_import_defs">Import definitions</string>

