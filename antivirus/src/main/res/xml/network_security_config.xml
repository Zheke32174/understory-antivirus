<?xml version="1.0" encoding="utf-8"?>
<!--
  Defense in depth. INTERNET is declared solely for the opt-in VirusTotal
  hash lookup (no default key ships, so the network path is dead until the
  user configures it — see AndroidManifest comments). This config denies
  cleartext everywhere, so the only traffic that can ever leave the app is
  HTTPS to the endpoint the user opted into.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
